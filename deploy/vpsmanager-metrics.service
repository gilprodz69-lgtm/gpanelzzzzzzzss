[Unit]
Description=VPS Manager metrics collection
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=vpsmanager
Group=vpsmanager
WorkingDirectory=/opt/vpsmanager/current
ExecStart=/usr/bin/php8.3 /opt/vpsmanager/current/scripts/console.php metrics
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vpsmanager/shared/storage
